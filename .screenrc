# Mouse wheel scrolls the terminal's native scrollback.
# Disabling the alternate screen (ti@ / te@) makes screen write to the
# emulator's main buffer, so the wheel scrolls back as in a normal shell.
defscrollback 1000000
termcapinfo xterm*|xterms|xs|rxvt|alacritty|foot|st*|tmux*|screen*|kitty* ti@:te@

# Keep windows out of utmp: half a dozen background sessions otherwise clutter
# who(1) and w(1). Side effect: write(1) can no longer reach them.
# This does NOT stop wall(1) broadcasts — those go to the attached client's own
# tty and land on top of screen regardless. smartd's are silenced at the source
# (services.smartd.notifications.wall.enable = false).
deflogin off
